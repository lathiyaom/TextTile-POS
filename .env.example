# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
APP_ENV=development

# Database Configuration (Docker Service Name 'db' for host)
DB_HOST=db
DB_PORT=3306
DB_USER=user
DB_PASSWORD=userpassword
DB_NAME=texttile
DB_ROOT_PASSWORD=rootpassword

# JWT Configuration
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRY_HOURS=24

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=debug

# Docker Compose Ports
BACKEND_PORT=8080
FRONTEND_PORT=5173
