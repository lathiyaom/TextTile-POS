# =============================================================================
# POS-GO Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment
# IMPORTANT: Never commit .env to version control!

# =============================================================================
# Application Environment
# =============================================================================
APP_ENV=development
# Options: development, staging, production

# =============================================================================
# Server Configuration
# =============================================================================
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# =============================================================================
# Database Configuration
# =============================================================================
# For Docker: use 'db' as host (service name)
# For local: use 'localhost' or '127.0.0.1'
DB_HOST=db
DB_PORT=3306
DB_USER=posuser
DB_PASSWORD=change-this-password-in-production
DB_NAME=texttile
DB_ROOT_PASSWORD=change-this-root-password-in-production

# Database Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# =============================================================================
# JWT Configuration
# =============================================================================
# IMPORTANT: Use a strong secret (minimum 32 characters) in production
JWT_SECRET=change-this-secret-key-minimum-32-characters-long
JWT_EXPIRY_HOURS=24

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=debug
# Options: debug, info, warn, error

# =============================================================================
# Docker Compose Port Mappings
# =============================================================================
# These ports are exposed on your host machine
BACKEND_PORT=8080
FRONTEND_PORT=3000
DB_PORT=3307

# Development-specific ports
FRONTEND_DEV_PORT=5173
ADMINER_PORT=8081
DEBUGGER_PORT=2345

# =============================================================================
# Application Metadata
# =============================================================================
APP_NAME=POS System
VERSION=1.0.0

# =============================================================================
# Frontend Environment Variables
# =============================================================================
# These are used during frontend build
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=POS System
VITE_APP_VERSION=1.0.0

# =============================================================================
# Production Settings (uncomment for production)
# =============================================================================
# APP_ENV=production
# LOG_LEVEL=info
# DB_PASSWORD=your-secure-production-password
# DB_ROOT_PASSWORD=your-secure-production-root-password
# JWT_SECRET=your-secure-production-jwt-secret-minimum-32-chars
# CORS_ALLOWED_ORIGINS=https://yourdomain.com

# =============================================================================
# Security Notes
# =============================================================================
# 1. Always use strong passwords (minimum 16 characters, mixed case, numbers, symbols)
# 2. JWT_SECRET should be at least 32 characters long
# 3. Never use default passwords in production
# 4. Keep .env file secure and never commit it to version control
# 5. Rotate secrets regularly in production
# 6. Use environment-specific .env files (.env.production, .env.staging)
